# Prevents CRA from injecting its own service worker chunk
# which would conflict with our custom /public/sw.js
INLINE_RUNTIME_CHUNK=false

# Prevents WebSocket port issues on Vercel
WDS_SOCKET_PORT=0

# Set to your actual Vercel deployment URL (no trailing slash)
# Replace with your real URL from Vercel dashboard
REACT_APP_API_URL=https://your-backend.onrender.com

# PWA name shown in browser install prompt
REACT_APP_NAME=A2S CRM
